# --- TEST/STAGING ENVIRONMENT VARIABLES ---
# Copy this to .env in your daily-sql-backend-test directory

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_test_password_here
POSTGRES_DB=daily_sql_test

# Database URL (Staging container connection)
DATABASE_URL=postgresql://postgres:your_secure_test_password_here@dailysql-postgres-staging:5432/daily_sql_test

# JWT Secret for test environment
JWT_SECRET=your_test_jwt_secret_here

# Google OAuth Credentials (shared with production or separate)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# URLs (Make sure to configure test-api and your local frontend)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=https://test-api.dailysql.in

# Admin Secret for test endpoints
ADMIN_SECRET=your_test_admin_secret_key
ADMIN_EMAIL=work.sharmaavinash@gmail.com

# Redis URL (internal docker networking for staging)
REDIS_URL=redis://dailysql-redis-staging:6379/0

# CORS origins (comma-separated, allowing local development)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Runner URLs (internal docker networking for staging)
PYTHON_RUNNER_URL=http://python-runner-staging:5001/execute
PYSPARK_RUNNER_URL=http://pyspark-runner-staging:5002/execute

# Third Party Configs
MOJOAUTH_API_KEY=53c2184a-2ca3-4753-8835-c264dc10d749
